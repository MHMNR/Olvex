#!/usr/bin/env bash
# Olvex CLI — talk to the live Quickshell instance (dev -p path or -c olvex).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
OLVEX_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [ ! -f "${OLVEX_ROOT}/shell.qml" ] && [ -f "${HOME}/.local/Olvex/shell.qml" ]; then
    OLVEX_ROOT="${HOME}/.local/Olvex"
    SCRIPT_DIR="${OLVEX_ROOT}/scripts"
fi

OLVEX_BACKEND="${SCRIPT_DIR}/olvex-backend.sh"
OLVEX_SHELL_DEFAULT="${OLVEX_ROOT}/shell.qml"

export QML_IMPORT_PATH="${OLVEX_ROOT}/build/qml${QML_IMPORT_PATH:+:${QML_IMPORT_PATH}}"
export QT_LOGGING_RULES="quickshell.dbus*=false;quickshell.dbus.properties*=false;qt.qml.propertyCache.append.warning=false;qt.qpa.wayland.textinput*=false;qt.qpa.wayland.*.warning=false;qt.qpa.wayland*=false${QT_LOGGING_RULES:+;${QT_LOGGING_RULES}}"

# Resolve qs instance: prefer running Olvex shell (project path > installed -c).
_olvex_qs_prefix() {
    local env_shell="${OLVEX_SHELL:-${QS_CONFIG_PATH:-}}"
    if [ -n "$env_shell" ] && [ -e "$env_shell" ]; then
        printf '%s\0%s\0' -p "$(readlink -f "$env_shell" 2>/dev/null || echo "$env_shell")"
        return
    fi

    local list
    list="$(qs list --all 2>/dev/null || true)"

    # Prefer live project config
    if [ -n "$list" ] && printf '%s\n' "$list" | grep -Fq "${OLVEX_ROOT}/shell.qml"; then
        printf '%s\0%s\0' -p "${OLVEX_SHELL_DEFAULT}"
        return
    fi
    if [ -n "$list" ] && printf '%s\n' "$list" | grep -Fq "${OLVEX_ROOT}/"; then
        printf '%s\0%s\0' -p "${OLVEX_SHELL_DEFAULT}"
        return
    fi

    # Running installed config
    if [ -n "$list" ] && printf '%s\n' "$list" | grep -Eqi 'quickshell/olvex'; then
        printf '%s\0%s\0' -c "${OLVEX_QS_INSTANCE:-olvex}"
        return
    fi

    # No running instance: default to project shell for IPC + start
    if [ -f "${OLVEX_SHELL_DEFAULT}" ]; then
        printf '%s\0%s\0' -p "${OLVEX_SHELL_DEFAULT}"
        return
    fi

    printf '%s\0%s\0' -c "${OLVEX_QS_INSTANCE:-olvex}"
}

_olvex_qs() {
    local mode path
    # shellcheck disable=SC2046
    {
        IFS= read -r -d '' mode
        IFS= read -r -d '' path
    } < <(_olvex_qs_prefix)
    exec qs "$mode" "$path" "$@"
}

_olvex_qs_run() {
    local mode path
    {
        IFS= read -r -d '' mode
        IFS= read -r -d '' path
    } < <(_olvex_qs_prefix)
    qs "$mode" "$path" "$@"
}

_olvex_backend() {
    exec "${OLVEX_BACKEND}" "$@"
}

_olvex_kill_running() {
    local mode path
    {
        IFS= read -r -d '' mode
        IFS= read -r -d '' path
    } < <(_olvex_qs_prefix)
    qs "$mode" "$path" kill >/dev/null 2>&1 || true
    # Also try the other common target so restarts don't leave orphans
    qs -p "${OLVEX_SHELL_DEFAULT}" kill >/dev/null 2>&1 || true
    qs -c "${OLVEX_QS_INSTANCE:-olvex}" kill >/dev/null 2>&1 || true
    sleep 0.15
}

if [ "${1:-}" = "" ]; then
    _olvex_backend --help
    exit 0
fi

if [ "$1" = "shell" ]; then
    shift
    case "${1:-}" in
        ""|-d|--daemon)
            _olvex_kill_running
            {
                IFS= read -r -d '' mode
                IFS= read -r -d '' path
            } < <(_olvex_qs_prefix)
            cd "${HOME}" || true
            exec qs -v "$mode" "$path" -d
            ;;
        kill|-k|--kill)
            _olvex_kill_running
            ;;
        restart)
            _olvex_kill_running
            {
                IFS= read -r -d '' mode
                IFS= read -r -d '' path
            } < <(_olvex_qs_prefix)
            cd "${HOME}" || true
            exec qs -v "$mode" "$path" -d
            ;;
        -s|--show|show|ipc-show)
            _olvex_qs_run ipc show
            ;;
        -l|--log|log)
            shift || true
            if [ "${1:-}" = "-r" ] || [ "${1:-}" = "--log-rules" ]; then
                shift
                _olvex_qs_run log -r "${1:-}"
            else
                _olvex_qs_run log
            fi
            ;;
        *)
            # IPC message: olvex shell drawers toggle launcher
            _olvex_qs_run ipc call "$@"
            ;;
    esac
elif [ "$1" = "wallpaper" ]; then
    if [ $# -gt 1 ]; then
        _olvex_backend "$@"
    else
        _olvex_qs_run ipc call drawers openWallpapers
    fi
elif [ "$1" = "screenshot" ]; then
    shift
    if [ $# -eq 0 ]; then
        _olvex_backend screenshot
    fi
    freeze=false
    region=false
    while [ $# -gt 0 ]; do
        case "$1" in
            -r|--region) region=true ;;
            -f|--freeze) freeze=true ;;
            *) _olvex_backend screenshot "$@" ;;
        esac
        shift
    done
    if $region; then
        if $freeze; then
            _olvex_qs_run ipc call picker openFreeze
        else
            _olvex_qs_run ipc call picker open
        fi
    elif $freeze; then
        _olvex_qs_run ipc call picker openFreeze
    else
        _olvex_backend screenshot
    fi
elif [ "$1" = "record" ]; then
    shift
    exec "${SCRIPT_DIR}/record.sh" "$@"
elif [ "$1" = "clipboard" ]; then
    shift
    _olvex_clipboard_bin() {
        if [ -x "${HOME}/.local/bin/olvex-clipboard" ]; then
            printf '%s\n' "${HOME}/.local/bin/olvex-clipboard"
            return 0
        fi
        if [ -x "${OLVEX_ROOT}/build/lib/olvex-clipboard" ]; then
            printf '%s\n' "${OLVEX_ROOT}/build/lib/olvex-clipboard"
            return 0
        fi
        if [ -x "${OLVEX_ROOT}/build/olvex-clipboard" ]; then
            printf '%s\n' "${OLVEX_ROOT}/build/olvex-clipboard"
            return 0
        fi
        if command -v olvex-clipboard >/dev/null 2>&1; then
            command -v olvex-clipboard
            return 0
        fi
        return 1
    }

    clipboard_bin="$(_olvex_clipboard_bin)" || clipboard_bin=""
    if [ -n "$clipboard_bin" ]; then
        exec "$clipboard_bin" "$@"
    fi

    echo "Clipboard app not found. Build or install olvex-clipboard first." >&2
    exit 1
elif [ "$1" = "resizer" ]; then
    shift
    if [ "${1:-}" = "pip" ]; then
        _olvex_qs_run ipc call resizer pip
    elif [ "${1:-}" = "-d" ] || [ "${1:-}" = "--daemon" ]; then
        echo "Window resizer is built natively into Olvex shell (C++). No separate daemon required."
    else
        _olvex_backend resizer "$@"
    fi
elif [ "$1" = "emoji" ]; then
    shift
    if [ "${1:-}" = "close" ] || [ "${1:-}" = "hide" ]; then
        pkill -x olvex-emoji >/dev/null 2>&1 || true
        exit 0
    fi
    if pgrep -x olvex-emoji >/dev/null 2>&1; then
        pkill -x olvex-emoji >/dev/null 2>&1 || true
        exit 0
    fi
    _olvex_emoji_bin() {
        if [ -x "${HOME}/.local/bin/olvex-emoji" ]; then
            printf '%s\n' "${HOME}/.local/bin/olvex-emoji"
            return 0
        fi
        if [ -x "${OLVEX_ROOT}/build/lib/olvex-emoji" ]; then
            printf '%s\n' "${OLVEX_ROOT}/build/lib/olvex-emoji"
            return 0
        fi
        if [ -x "${OLVEX_ROOT}/build/olvex-emoji" ]; then
            printf '%s\n' "${OLVEX_ROOT}/build/olvex-emoji"
            return 0
        fi
        if command -v olvex-emoji >/dev/null 2>&1; then
            command -v olvex-emoji
            return 0
        fi
        return 1
    }

    emoji_bin="$(_olvex_emoji_bin)" || emoji_bin=""
    if [ -n "$emoji_bin" ]; then
        exec "$emoji_bin" "$@"
    fi

    echo "Emoji app not found. Build or install olvex-emoji first." >&2
    exit 1
elif [ "$1" = "toggle" ]; then
    shift
    _olvex_qs_run ipc call drawers toggle "$@"
elif [ "$1" = "update" ]; then
    shift
    _olvex_update() {
        local force=false
        local check_only=false
        while [ $# -gt 0 ]; do
            case "$1" in
                --force|-f) force=true ;;
                --check|-c) check_only=true ;;
                *) ;;
            esac
            shift
        done

        local install_conf="/etc/olvex/install.conf"
        local repo_url="https://github.com/MHMNR/Olvex.git"
        local branch="Main"
        local aur_helper=""
        local repo_dir=""

        # 1. Read /etc/olvex/install.conf if available
        if [ -f "$install_conf" ]; then
            # shellcheck disable=SC1090
            source "$install_conf" 2>/dev/null || true
            [ -n "${REPO_URL:-}" ] && repo_url="$REPO_URL"
            [ -n "${BRANCH:-}" ] && branch="$BRANCH"
            [ -n "${AUR_HELPER:-}" ] && aur_helper="$AUR_HELPER"
            [ -n "${REPO_DIR:-}" ] && repo_dir="$REPO_DIR"
        fi

        # 2. Auto-detect AUR helper if not set
        if [ -z "$aur_helper" ]; then
            if command -v paru >/dev/null 2>&1; then
                aur_helper="paru"
            elif command -v yay >/dev/null 2>&1; then
                aur_helper="yay"
            else
                aur_helper="pacman"
            fi
        fi

        # 3. Locate or set up repository tracking directory
        if [ -z "$repo_dir" ] || [ ! -d "$repo_dir/.git" ]; then
            if [ -d "${OLVEX_ROOT}/../.git" ] && [ -f "${OLVEX_ROOT}/../setup.sh" ]; then
                repo_dir="$(cd "${OLVEX_ROOT}/.." && pwd)"
            elif [ -d "${HOME}/.local/share/olvex/repo/.git" ]; then
                repo_dir="${HOME}/.local/share/olvex/repo"
            elif [ -d "${OLVEX_ROOT}/.git" ] && [ -f "${OLVEX_ROOT}/setup.sh" ]; then
                repo_dir="${OLVEX_ROOT}"
            else
                repo_dir="${HOME}/.local/share/olvex/repo"
            fi
        fi

        echo -e "\033[1;36m:: Olvex Shell Automated Updater\033[0m"
        echo -e "   Target Core : \033[0;33m${OLVEX_ROOT}\033[0m"
        echo -e "   Repo Dir    : \033[0;33m${repo_dir}\033[0m"
        echo -e "   Upstream    : \033[0;33m${repo_url} (${branch})\033[0m"

        # 4. Clone repo if directory doesn't exist
        if [ ! -d "${repo_dir}/.git" ]; then
            echo -e ":: Setting up Olvex repository tracking in ${repo_dir}..."
            mkdir -p "$(dirname "$repo_dir")"
            if ! git clone --branch "${branch}" "${repo_url}" "${repo_dir}"; then
                echo -e "\033[1;31mError: Failed to clone repository from ${repo_url}.\033[0m" >&2
                return 1
            fi
        else
            # Ensure remote URL and branch tracking are up to date
            git -C "${repo_dir}" remote set-url origin "${repo_url}" 2>/dev/null || true
        fi

        # 5. Fetch upstream
        echo -e ":: Fetching latest changes from upstream..."
        if ! git -C "${repo_dir}" fetch origin "${branch}" --quiet; then
            echo -e "\033[1;31mError: Failed to fetch from ${repo_url}. Check your internet connection.\033[0m" >&2
            return 1
        fi

        local local_hash remote_hash
        local_hash="$(git -C "${repo_dir}" rev-parse HEAD 2>/dev/null || echo "none")"
        remote_hash="$(git -C "${repo_dir}" rev-parse "origin/${branch}" 2>/dev/null || echo "")"

        if [ -z "$remote_hash" ]; then
            echo -e "\033[1;31mError: Remote branch '${branch}' not found.\033[0m" >&2
            return 1
        fi

        if [ "$local_hash" = "$remote_hash" ] && [ "$force" = false ]; then
            echo -e "\033[1;32m✔ Olvex is already up to date (${local_hash:0:7}).\033[0m"
            return 0
        fi

        echo -e ":: Update available: \033[1;33m${local_hash:0:7}\033[0m -> \033[1;32m${remote_hash:0:7}\033[0m"
        if [ "$check_only" = true ]; then
            return 0
        fi

        # 6. Fast-forward code
        echo -e ":: Updating source code..."
        git -C "${repo_dir}" reset --hard "origin/${branch}"
        git -C "${repo_dir}" submodule update --init --recursive --quiet 2>/dev/null || true

        # 7. Execute incremental build via setup.sh --build
        if [ -f "${repo_dir}/setup.sh" ]; then
            echo -e ":: Compiling and deploying Olvex updates..."
            chmod +x "${repo_dir}/setup.sh"
            "${repo_dir}/setup.sh" --build
        else
            echo -e "\033[1;31mError: Missing setup.sh in ${repo_dir}\033[0m" >&2
            return 1
        fi

        # 8. Persist updated state in /etc/olvex/install.conf
        sudo mkdir -p /etc/olvex
        local now_date
        now_date="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
        sudo tee "$install_conf" >/dev/null <<EOF
# Olvex System Installation State
REPO_URL="${repo_url}"
BRANCH="${branch}"
REPO_DIR="${repo_dir}"
AUR_HELPER="${aur_helper}"
LOGIN_METHOD="${LOGIN_METHOD:-1}"
DM_CHOICE="${DM_CHOICE:-1}"
DRIVERS="${DRIVERS:-false}"
SET_FISH="${SET_FISH:-false}"
INSTALLED_COMMIT="${remote_hash}"
INSTALLED_DATE="${now_date}"
EOF
        sudo chmod 644 "$install_conf"

        # 9. Gracefully reload running shell
        echo -e ":: Reloading Olvex shell..."
        "${SCRIPT_DIR}/olvex" shell restart >/dev/null 2>&1 || true

        if command -v notify-send >/dev/null 2>&1; then
            notify-send "Olvex Shell" "Updated to ${remote_hash:0:7} successfully!" -i preferences-system 2>/dev/null || true
        fi

        echo -e "\033[1;32m✔ Olvex Shell successfully updated to ${remote_hash:0:7}!\033[0m"
        return 0
    }
    _olvex_update "$@"
    exit $?
else
    _olvex_backend "$@"
fi
