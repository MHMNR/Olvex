            x: 116
            y: 46
            opacity: 0

            StyledText {
                width: parent.width
                text: Players.active ? (Players.active.trackTitle || qsTr("Unknown Title")) : qsTr("Nothing Playing")
                color: Players.musicOnSurfaceColor
                textPointSize: Tokens.font.size.normal
                font.weight: 760
                elide: Text.ElideRight
