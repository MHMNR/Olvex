                    asynchronous: true
                    cache: !root.artIsLocal
                    sourceSize: Qt.size(width, height)
                    opacity: status === Image.Ready && source !== "" ? 1 : 0
                    Behavior on opacity { NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }
                }
            }

            MaterialIcon {
                id: musicPlaceholderIcon
                anchors.centerIn: parent
                text: "music_note"
                color: root.hasMusicArt ? Qt.alpha(Players.musicOnSurfaceColor, 0.4) : Qt.alpha(Players.musicOnSurfaceColor, 0.84)
                iconPointSize: musicIcon.expanded ? 28 : 14
                visible: !root.hasMusicArt || artImage.status !== Image.Ready
                fill: 1
            }
        }

        Rectangle {
            id: titleChip
            x: 116
            y: 18
            width: 60
            height: 22
            radius: 11
            color: Qt.alpha(root.resolvedVisualizerAccent, 0.12)
            border.width: 1
            border.color: Qt.alpha(root.resolvedVisualizerAccent, 0.18)
            opacity: 0
        }

        StyledText {
            id: titleChipText
            anchors.centerIn: titleChip
