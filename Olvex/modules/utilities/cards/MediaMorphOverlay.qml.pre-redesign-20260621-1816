            hoverEnabled: true
            onClicked: (mouse) => {
                mouse.accepted = true;
                if (root.seekPreview >= 0)
                    return;
                if (musicPill.state === "expanded")
                    return;
                if (!root.active)
                    root.expand();
            }
        }


        Item {
            id: musicIcon

            property real radius: Math.min(width, height) / 2
            readonly property real artInset: musicPill.state === "expanded" ? 8 : 5
            readonly property bool expanded: musicPill.state === "expanded"

            width: 34
            height: 34
            x: 7
            y: 7

            MaterialShape {
                anchors.centerIn: parent
                implicitSize: Math.min(parent.width, parent.height) + (musicIcon.expanded ? 18 : 0)
                width: implicitSize
                height: implicitSize
                shape: MaterialShape.Cookie9Sided
                visible: musicIcon.expanded
                color: Qt.alpha(root.resolvedVisualizerAccent, 0.08)
                strokeColor: Qt.alpha(root.resolvedVisualizerAccent, 0.18)
