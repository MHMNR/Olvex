                implicitSize: Math.min(parent.width, parent.height)
                width: implicitSize
                height: implicitSize
                shape: musicIcon.expanded ? MaterialShape.Cookie9Sided : MaterialShape.Cookie12Sided
                color: Qt.alpha(root.resolvedVisualizerAccent, musicIcon.expanded ? 0.12 : 0.10)
                strokeColor: Qt.alpha(root.resolvedVisualizerAccent, musicIcon.expanded ? 0.72 : 0.42)
                strokeWidth: musicIcon.expanded ? 2 : 2

                Anim on rotation {
                    running: (Players.active?.isPlaying ?? false) && !root.morphAnimating
                    from: 360
                    to: 0
                    duration: 24000
                    easing.type: Easing.Linear
                    loops: Animation.Infinite
                }
