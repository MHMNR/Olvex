        property real clickScale: 1.0
        property real iconKick: 1.0
        property real radius: Math.min(width, height) / 2
        readonly property real visualScale: clickScale
            * (stateLayer.pressed ? 0.90 : (stateLayer.containsMouse ? 1.05 : 1.0))
        readonly property real innerPad: control.emphasized ? 0 : 4
        readonly property color activeIconColor: control.emphasized
            ? root.playIconColor
            : Qt.alpha(Players.musicOnSurfaceColor, stateLayer.containsMouse ? 0.98 : 0.78)
        readonly property color disabledIconColor: Qt.alpha(Players.musicOnSurfaceColor, 0.25)
        readonly property color containerTone: control.emphasized
            ? root.resolvedPlayButtonBg
            : (control.expandedTone
                ? Qt.alpha(Players.musicOnSurfaceColor, stateLayer.containsMouse ? 0.18 : 0.075)
                : "transparent")
        readonly property color strokeColor: control.emphasized
            ? Qt.alpha(root.playIconColor, stateLayer.pressed ? 0.30 : 0.16)
            : (control.expandedTone
                ? Qt.alpha(Players.musicOnSurfaceColor, stateLayer.containsMouse ? 0.24 : 0.10)
                : "transparent")

        width: 30
        height: 30
        clip: true
        scale: visualScale

        MaterialShape {
            id: controlShape

            anchors.centerIn: parent
            implicitSize: Math.max(1, Math.min(parent.width, parent.height) - control.innerPad)
            shape: stateLayer.pressed
                ? MaterialShape.Cookie12Sided
                : (control.emphasized ? MaterialShape.Circle : MaterialShape.Pill)
            color: control.containerTone
            strokeColor: control.strokeColor
            strokeWidth: control.emphasized || control.expandedTone ? 1 : 0
            animationDuration: Tokens.anim.durations.expressiveFastSpatial
            animationEasing: Tokens.anim.expressiveFastSpatial

            Behavior on color {
                ColorAnimation {
                    duration: Tokens.anim.durations.expressiveFastEffects
                    easing: Tokens.anim.expressiveFastEffects
                }
            }

            Behavior on strokeColor {
                ColorAnimation {
                    duration: Tokens.anim.durations.expressiveFastEffects
                    easing: Tokens.anim.expressiveFastEffects
                }
            }
        }

        Behavior on scale {
            SpringAnimation { spring: 5.2; damping: 0.62; mass: 1.0; epsilon: 0.004 }
        }

        MaterialIcon {
            id: controlIcon
            anchors.centerIn: parent
            scale: control.iconKick
            text: control.iconName
            color: Players.active ? control.activeIconColor : control.disabledIconColor
            iconPointSize: control.iconSize
            fill: control.emphasized ? 1 : 0
            font.weight: control.emphasized ? 850 : 650
            horizontalAlignment: Text.AlignHCenter
            verticalAlignment: Text.AlignVCenter
            animate: control.emphasized
            animateProp: "rotation"
            animateFrom: 90
            animateTo: 0
            animateDuration: 320
        }

        Behavior on iconKick {
            SpringAnimation { spring: 5.4; damping: 0.66; mass: 1.0; epsilon: 0.004 }
        }

        SequentialAnimation {
            id: pressSpring
            ParallelAnimation {
                NumberAnimation {
                    target: control
                    property: "clickScale"
                    to: 0.84
                    duration: Tokens.anim.durations.expressiveFastEffects
                    easing: Tokens.anim.expressiveFastSpatial
                }
                NumberAnimation {
                    target: control
                    property: "iconKick"
                    to: 0.76
                    duration: Tokens.anim.durations.expressiveFastEffects
                    easing: Tokens.anim.expressiveFastSpatial
                }
            }
            ParallelAnimation {
                SpringAnimation { target: control; property: "clickScale"; to: 1.0; spring: 5.6; damping: 0.58; mass: 1.0; epsilon: 0.004 }
                SpringAnimation { target: control; property: "iconKick"; to: 1.0; spring: 5.4; damping: 0.60; mass: 1.0; epsilon: 0.004 }
            }
        }

        StateLayer {
            id: stateLayer
            radius: parent.radius
            showHoverBackground: false
            showRipple: true
            color: control.emphasized ? control.activeIconColor : Players.musicOnSurfaceColor
            enabled: Players.active !== null
            onPressed: pressSpring.restart()
            onClicked: control.clicked()
        }
    }


    // ── The Morphing Card ────────────────────────────────────────────────────────
    Rectangle {
        id: musicPill

        z: 1
        opacity: root.active ? 1 : 0
        enabled: root.active

        // Initial setup
        x: root.startX
        y: root.startY
        width: root.startW
        height: root.startH
        radius: root.startRadius
        clip: true

        color: Qt.alpha(Players.musicSurfaceColor, 0.97)
        border.width: musicPill.state === "expanded" ? 1 : 0
        border.color: Qt.alpha(Players.musicOnSurfaceColor, 0.10)

        layer.enabled: root.morphAnimating
        layer.smooth: true

        state: "compact"

        // Dynamic Island squash: subtle horizontal bloom on expand, vertical on collapse
        property real morphSquashX: 1.0
        property real morphSquashY: 1.0
        property real morphLift: 0.0

        transform: [
            Translate {
                x: root.opensRight ? musicPill.morphLift : -musicPill.morphLift
                y: 0
            },
            Scale {
                origin.x: root.opensRight ? 0 : musicPill.width
                origin.y: musicPill.height / 2
                xScale: musicPill.morphSquashX
                yScale: musicPill.morphSquashY
            }
        ]


        Rectangle {
            anchors.fill: parent
            color: Qt.alpha(Colours.palette.m3surfaceTint, musicPill.state === "expanded" ? 0.075 : 0.02)
        }

        MaterialShape {
            id: cardTintShape
            x: musicPill.state === "expanded" ? 252 : musicPill.width - implicitSize - 12
            y: musicPill.state === "expanded" ? -42 : musicPill.height - implicitSize + 26
            implicitSize: musicPill.state === "expanded" ? 118 : 58
            width: implicitSize
            height: implicitSize
            shape: musicPill.state === "expanded" ? MaterialShape.Cookie9Sided : MaterialShape.Cookie12Sided
            visible: musicPill.width > 40
            color: Qt.alpha(root.resolvedVisualizerAccent, musicPill.state === "expanded" ? 0.06 : 0.02)
            strokeColor: Qt.alpha(root.resolvedVisualizerAccent, musicPill.state === "expanded" ? 0.10 : 0.08)
            strokeWidth: musicPill.state === "expanded" ? 1 : 0

            Anim on rotation {
                running: (Players.active?.isPlaying ?? false) && musicPill.state === "expanded"
                from: 0
                to: 360
                duration: 26000
                easing.type: Easing.Linear
                loops: Animation.Infinite
