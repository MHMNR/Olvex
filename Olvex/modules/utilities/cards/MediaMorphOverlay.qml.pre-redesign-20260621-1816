        MaterialShape {
            x: controlsSurface.x + 80
            y: controlsSurface.y - 5
            implicitSize: 60
            width: implicitSize
            height: implicitSize
            shape: MaterialShape.Cookie9Sided
            color: Qt.alpha(root.playButtonBg, controlsSurface.opacity * 0.10)
            strokeColor: Qt.alpha(root.playButtonBg, controlsSurface.opacity * 0.18)
            strokeWidth: 1
            visible: musicPill.state === "expanded"

            Anim on rotation {
                running: (Players.active?.isPlaying ?? false) && !root.morphAnimating
                from: 0
                to: 360
                duration: 18000
                easing.type: Easing.Linear
                loops: Animation.Infinite
            }
        }

        MorphControlButton {
            id: prevBtnContainer
            iconName: "skip_previous"
            iconSize: 14
            expandedTone: musicPill.state === "expanded"
            onClicked: Players.previous()
        }

        MorphControlButton {
            id: playBtn
            iconName: (Players.active && Players.active.isPlaying) ? "pause" : "play_arrow"
            emphasized: true
            iconSize: 16
            onClicked: Players.togglePlaying()
        }

        MorphControlButton {
            id: nextBtnContainer
            iconName: "skip_next"
            iconSize: 14
            expandedTone: musicPill.state === "expanded"
            onClicked: Players.next()
        }


        Item {
            id: expandedContent
            anchors.fill: parent

            Item {
                id: expandedProgressWrap
                x: 24
                y: 124
                width: parent.width - 48
                height: 32

                RowLayout {
                    id: progressTimes
                    anchors.top: parent.top
                    anchors.left: parent.left
                    anchors.right: parent.right
                    spacing: 0

                    StyledText {
                        text: root.lengthStr(Players.active ? root.displayPosition : -1)
                        color: Qt.alpha(Players.musicOnSurfaceColor, 0.62)
                        textPointSize: Tokens.font.size.smaller
                        font.weight: Font.Medium
                    }

                    Item { Layout.fillWidth: true }

                    StyledText {
                        text: root.lengthStr(root.playerLength > 0 ? root.playerLength : -1)
                        color: Qt.alpha(Players.musicOnSurfaceColor, 0.62)
                        textPointSize: Tokens.font.size.smaller
                        font.weight: Font.Medium
                    }
                }

                Item {
                    id: progressBarArea
                    anchors.top: progressTimes.bottom
                    anchors.topMargin: 6
                    anchors.left: parent.left
                    anchors.right: parent.right
                    anchors.bottom: parent.bottom

                    readonly property real trackHeight: 7 + root.morphAudioIntensity * 3
                    readonly property real thumbSize: trackHeight + (progressSeekArea.containsMouse || progressSeekArea.pressed ? 12 : 8)
                    readonly property real thumbCenterX: width * root.displayProgress
                    readonly property real clampedThumbX: Math.max(0, Math.min(width - thumbSize, thumbCenterX - thumbSize / 2))

                    Rectangle {
                        anchors.fill: parent
                        anchors.leftMargin: -2
                        anchors.rightMargin: -2
                        radius: height / 2
                        color: Qt.alpha(Players.musicOnSurfaceColor, 0.028)
                        border.width: 1
                        border.color: Qt.alpha(Players.musicOnSurfaceColor, 0.050)
                    }

                    MouseArea {
                        id: progressSeekArea
                        anchors.fill: parent
                        anchors.topMargin: -10
                        anchors.bottomMargin: -10
                        enabled: musicPill.state === "expanded" && root.canSeek
                        hoverEnabled: true
                        cursorShape: enabled ? Qt.PointingHandCursor : Qt.ArrowCursor
                        preventStealing: true
                        z: 10

                        function fractionAt(mouseX: real): real {
                            const w = progressBarArea.width;
                            if (w <= 0)
                                return 0;
                            return Math.max(0, Math.min(1, mouseX / w));
                        }

                        onPressed: (mouse) => {
                            root.seekPreview = fractionAt(mouse.x);
                            mouse.accepted = true;
                        }

                        onPositionChanged: (mouse) => {
                            if (pressed)
                                root.seekPreview = fractionAt(mouse.x);
                        }

                        onReleased: (mouse) => {
                            if (root.seekPreview >= 0)
                                Players.seekTo(root.seekPreview);
                            root.seekPreview = -1;
                            mouse.accepted = true;
                        }

                        onCanceled: root.seekPreview = -1
                    }

                    StyledProgressBar {
                        id: expandedProgressTrack
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.verticalCenter: parent.verticalCenter
                        height: progressBarArea.trackHeight
                        from: 0
                        to: 1
                        value: root.displayProgress
                        wavy: (Players.active?.isPlaying ?? false) && !root.morphAnimating
                        wavePaused: root.morphAnimating || !(Players.active?.isPlaying ?? false)
                        waveFrequency: 6
                        waveAmplitude: 0.22 + root.morphAudioIntensity * 0.16
                        waveDuration: 1180
                        fgColour: Qt.alpha(root.resolvedVisualizerAccent, 0.84)
                        bgColour: Qt.alpha(Players.musicOnSurfaceColor, 0.10 + root.morphAudioIntensity * 0.03)
                        z: 1

                        Behavior on height {
                            SpringAnimation { spring: 3.8; damping: 0.74; mass: 1.0; epsilon: 0.005 }
                        }
                    }

                    Repeater {
                        model: musicPill.state === "expanded" ? 5 : 0

                        delegate: MaterialShape {
                            required property int index
                            readonly property real markerX: (index + 1) * progressBarArea.width / 6
                            x: markerX - width / 2
                            anchors.verticalCenter: parent.verticalCenter
                            width: implicitSize
                            height: implicitSize
                            implicitSize: index % 2 === 0
                                ? progressBarArea.trackHeight + 5
                                : progressBarArea.trackHeight + 1
                            shape: MaterialShape.Circle
                            color: Qt.alpha(Players.musicOnSurfaceColor, 0.16)
                            visible: markerX > progressBarArea.thumbCenterX + 12
                            z: 2
                        }
                    }

                    MaterialShape {
                        id: expandedProgressThumb
                        anchors.verticalCenter: parent.verticalCenter
                        x: progressBarArea.clampedThumbX
                        width: implicitSize
                        height: implicitSize
                        implicitSize: progressBarArea.thumbSize
                        shape: progressSeekArea.pressed ? MaterialShape.Cookie12Sided : MaterialShape.Circle
                        color: Qt.alpha(Players.musicOnSurfaceColor, 0.96)
                        visible: root.hasProgressFill
                        z: 3

                        Behavior on x {
                            Anim { type: Anim.FastSpatial }
                        }

                        Behavior on implicitSize {
                            SpringAnimation { spring: 4.2; damping: 0.70; mass: 1.0; epsilon: 0.005 }
                        }

                        layer.enabled: !root.morphAnimating
                        layer.effect: MultiEffect {
                            shadowEnabled: true
                            shadowColor: Qt.alpha(root.resolvedVisualizerAccent, 0.88)
                            shadowOpacity: 0.70 + root.morphAudioIntensity * 0.25
                            shadowBlur: 0.80
                            shadowHorizontalOffset: 0
                            shadowVerticalOffset: 0
                        }
                    }
                }
            }
        }

        states: [
            State {
                name: "compact"
                PropertyChanges { target: musicPill; x: root.startX; y: root.startY; width: root.startW; height: root.startH; radius: root.startRadius }
                PropertyChanges { target: musicIcon; width: root.realArtW; height: root.realArtH; radius: root.realArtH / 2; x: root.realArtX; y: root.realArtY }
                PropertyChanges { target: titleChip; opacity: 0 }
                PropertyChanges { target: trackInfo; opacity: 0 }
                PropertyChanges { target: controlsSurface; opacity: 0 }
                PropertyChanges { target: expandedProgressWrap; opacity: 0 }
                PropertyChanges { target: prevBtnContainer; x: root.realBtn1X; y: root.realBtn1Y; opacity: 1; width: root.realBtnSize; height: root.realBtnSize; radius: root.realBtnSize / 2 }
                PropertyChanges { target: playBtn; x: root.realBtn2X; y: root.realBtn2Y; width: root.realBtnSize; height: root.realBtnSize }
                PropertyChanges { target: nextBtnContainer; x: root.realBtn3X; y: root.realBtn3Y; opacity: 1; width: root.realBtnSize; height: root.realBtnSize; radius: root.realBtnSize / 2 }
                PropertyChanges { target: playBtn; iconSize: Tokens.font.size.larger }
                PropertyChanges { target: prevBtnContainer; iconSize: Tokens.font.size.large }
                PropertyChanges { target: nextBtnContainer; iconSize: Tokens.font.size.large }
            },
            State {
                name: "expanded"
                PropertyChanges { target: musicPill; x: root.endX; y: root.endY; width: root.endW; height: root.endH; radius: root.endRadius }
                PropertyChanges { target: musicIcon; width: 72; height: 72; radius: 22; x: 24; y: 24 }
                PropertyChanges { target: titleChip; opacity: 1 }
                PropertyChanges { target: trackInfo; opacity: 1 }
                PropertyChanges { target: controlsSurface; opacity: 1 }
                PropertyChanges { target: expandedProgressWrap; opacity: 1 }
                PropertyChanges { target: prevBtnContainer; x: 132; y: 77; opacity: 1; width: 36; height: 36; radius: 18 }
                PropertyChanges { target: playBtn; x: 200; y: 70; width: 50; height: 50; radius: 25 }
                PropertyChanges { target: nextBtnContainer; x: 278; y: 77; opacity: 1; width: 36; height: 36; radius: 18 }
                PropertyChanges { target: playBtn; iconSize: 24 }
                PropertyChanges { target: prevBtnContainer; iconSize: 20 }
                PropertyChanges { target: nextBtnContainer; iconSize: 20 }
            }
        ]

        transitions: [
            Transition {
                id: expandTransition
                from: "compact"; to: "expanded"
                ParallelAnimation {
                    NumberAnimation {
                        targets: [musicPill]
                        properties: "x,y,width,height,radius"
                        duration: root.expandDur
                        easing: root.spatialEasing
                    }
                    NumberAnimation {
                        targets: [musicIcon]
                        properties: "x,y,width,height,radius"
                        duration: root.expandDur
                        easing: root.spatialEasing
                    }
                    NumberAnimation {
                        targets: [prevBtnContainer, playBtn, nextBtnContainer]
                        properties: "x,y,width,height,radius"
                        duration: root.expandDur
                        easing: root.spatialEasing
                    }
                    SequentialAnimation {
                        PauseAnimation { duration: 60 }
                        NumberAnimation {
                            targets: [prevBtnContainer, playBtn, nextBtnContainer]
                            property: "iconSize"
                            duration: 250
                            easing: root.spatialEasing
                        }
                    }
                    SequentialAnimation {
                        NumberAnimation {
                            target: musicPill
                            property: "morphSquashX"
                            to: 1.045
                            duration: Tokens.anim.durations.expressiveFastEffects
                            easing: Tokens.anim.expressiveFastSpatial
                        }
                        NumberAnimation {
                            target: musicPill
                            property: "morphSquashX"
                            to: 1.0
                            duration: Math.round(root.expandDur * 0.58)
                            easing: root.spatialEasingDecel
                        }
                    }
                    SequentialAnimation {
                        NumberAnimation {
                            target: musicPill
                            property: "morphSquashY"
                            to: 0.965
                            duration: Tokens.anim.durations.expressiveFastEffects
                            easing: Tokens.anim.expressiveFastSpatial
                        }
                        NumberAnimation {
                            target: musicPill
                            property: "morphSquashY"
                            to: 1.0
                            duration: Math.round(root.expandDur * 0.58)
                            easing: root.spatialEasingDecel
                        }
                    }
                    SequentialAnimation {
                        NumberAnimation {
                            target: musicPill
                            property: "morphLift"
                            to: 8
                            duration: Tokens.anim.durations.expressiveFastEffects
                            easing: Tokens.anim.expressiveFastSpatial
                        }
                        NumberAnimation {
                            target: musicPill
                            property: "morphLift"
                            to: 0
                            duration: Math.round(root.expandDur * 0.58)
                            easing: root.spatialEasingDecel
                        }
                    }
                    SequentialAnimation {
                        PauseAnimation { duration: root.contentRevealDelay }
                        NumberAnimation {
                            targets: [titleChip, trackInfo, controlsSurface]
                            property: "opacity"
                            to: 1
                            duration: Tokens.anim.durations.expressiveDefaultEffects
                            easing: Tokens.anim.emphasizedDecel
                        }
                    }
                    SequentialAnimation {
                        PauseAnimation { duration: root.progressRevealDelay }
                        NumberAnimation {
                            target: expandedProgressWrap
                            property: "opacity"
                            to: 1
                            duration: Tokens.anim.durations.expressiveDefaultEffects
                            easing: Tokens.anim.emphasizedDecel
                        }
                    }
                }
            },

            Transition {
                id: collapseTransition
                from: "expanded"; to: "compact"
                ParallelAnimation {
                    NumberAnimation {
                        targets: [titleChip, trackInfo, controlsSurface, expandedProgressWrap]
                        property: "opacity"
                        to: 0
                        duration: Tokens.anim.durations.expressiveFastEffects
                        easing: Tokens.anim.expressiveFastSpatial
                    }
                    NumberAnimation {
                        targets: [musicPill, musicIcon]
                        properties: "x,y,width,height,radius"
                        duration: root.collapseDur
                        easing: root.spatialEasing
                    }
                    NumberAnimation {
                        targets: [prevBtnContainer, playBtn, nextBtnContainer]
                        properties: "x,y,width,height,radius"
                        duration: root.collapseDur
                        easing: root.spatialEasing
                    }
                    NumberAnimation {
                        targets: [prevBtnContainer, playBtn, nextBtnContainer]
                        property: "iconSize"
                        duration: root.collapseDur
                        easing: root.spatialEasing
                    }
                    SequentialAnimation {
                        NumberAnimation {
                            target: musicPill
                            property: "morphSquashY"
                            to: 1.035
                            duration: Tokens.anim.durations.expressiveFastEffects
                            easing: Tokens.anim.expressiveFastSpatial
                        }
                        NumberAnimation {
                            target: musicPill
                            property: "morphSquashY"
                            to: 1.0
                            duration: Math.round(root.collapseDur * 0.55)
                            easing: root.spatialEasingDecel
                        }
                    }
                    SequentialAnimation {
                        NumberAnimation {
                            target: musicPill
                            property: "morphSquashX"
                            to: 0.965
                            duration: Tokens.anim.durations.expressiveFastEffects
                            easing: Tokens.anim.expressiveFastSpatial
                        }
                        NumberAnimation {
                            target: musicPill
                            property: "morphSquashX"
                            to: 1.0
                            duration: Math.round(root.collapseDur * 0.55)
                            easing: root.spatialEasingDecel
                        }
                    }
                    SequentialAnimation {
                        NumberAnimation {
                            target: musicPill
                            property: "morphLift"
                            to: 6
                            duration: Tokens.anim.durations.expressiveFastEffects
                            easing: Tokens.anim.expressiveFastSpatial
                        }
                        NumberAnimation {
                            target: musicPill
                            property: "morphLift"
                            to: 0
                            duration: Math.round(root.collapseDur * 0.55)
                            easing: root.spatialEasingDecel
                        }
                    }
                }
            }
        ]
    }
}
