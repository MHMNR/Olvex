            Rectangle {
                anchors.centerIn: parent
                width: Math.max(1, parent.width - 14)
                height: width
                radius: width / 2
                visible: musicIcon.expanded
                color: "transparent"
                border.width: 1
                border.color: Qt.alpha(Players.musicOnSurfaceColor, 0.16)
