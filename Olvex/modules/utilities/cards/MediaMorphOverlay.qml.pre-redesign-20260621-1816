        }

        Rectangle {
            id: controlsInnerSurface
            x: controlsSurface.x + 6
            y: controlsSurface.y + 6
            width: controlsSurface.width - 12
            height: controlsSurface.height - 12
            radius: 19
            color: Qt.alpha(Players.musicSurfaceColor, 0.14)
            border.width: 1
